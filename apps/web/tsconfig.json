{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"types": ["vite/client"],
		"paths": {
			"@/*": ["./src/*"],
			"@style/*": ["./styled-system/*"],
			"@assets/*": ["./src/assets/*"],
			"@shared/*": ["../../libs/shared/*"],
			"solid-js": ["../../node_modules/solid-js"],
			"solid-js/*": ["../../node_modules/solid-js/*"]
		}
	},
	"include": ["src", "misc.d.ts"]
}
