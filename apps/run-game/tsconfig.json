{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"types": ["vite/client"],
		"paths": {
			"@/*": ["../web/src/*"],
			"solid-js": ["./node_modules/solid-js"],
			"solid-js/*": ["./node_modules/solid-js/*"],
			"@shared/*": ["../../libs/shared/*"]
		}
	},
	"include": ["src", "../web/misc.d.ts"]
}
