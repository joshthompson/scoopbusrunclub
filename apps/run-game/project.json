{
	"name": "run-game",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/run-game/src",
	"targets": {
		"dev": {
			"command": "pnpm dev",
			"options": {
				"cwd": "apps/run-game"
			}
		},
		"build": {
			"command": "pnpm build",
			"options": {
				"cwd": "apps/run-game"
			},
			"outputs": ["{projectRoot}/dist"]
		},
		"serve": {
			"command": "vite preview",
			"options": {
				"cwd": "apps/run-game"
			}
		}
	}
}
