{
	"name": "results-scraper",
	"$schema": "../../node_modules/nx/schemas/project-schema.json",
	"projectType": "application",
	"sourceRoot": "apps/results-scraper/src",
	"targets": {
		"build": {
			"command": "tsx apps/results-scraper/build.mts",
			"options": { "cwd": "." }
		},
		"pack": {
			"command": "tsx apps/results-scraper/build.mts --pack",
			"options": { "cwd": "." }
		},
		"watch": {
			"command": "tsx apps/results-scraper/build.mts --watch",
			"options": { "cwd": "." }
		}
	}
}
